@startuml diagrama_componentes_aluguel
skinparam shadowing false
skinparam componentStyle rectangle

actor Cliente
actor Agente

node "Computador / navegador" as browser {
  component "Páginas web\nThymeleaf" as pages
}

cloud Internet

node "Servidor central" as server {
  component "ClienteController\n<<MVC Controller>>" as controller
  component "ClienteService\n<<Application Service>>" as service
  component "Gestão de pedidos\ne contratos\n<<Sprint 3>>" as pedidos
  component "Construção dinâmica\nde páginas\n<<Spring MVC + Thymeleaf>>" as web
  component "ClienteRepository\n<<Spring Data JPA>>" as repository
  component "Validação\n<<Bean Validation>>" as validation
}

database "H2\n<<Sprint 2>>" as database

Cliente --> pages
Agente --> pages
pages --> Internet : HTTPS
Internet --> controller : requisições HTTP
controller --> validation : valida formulários
controller --> service : CRUD de cliente
controller --> web : seleciona view e modelo
web --> pages : HTML renderizado
service --> repository
service ..> pedidos : cliente será contratante
repository --> database : JPA/JDBC

note right of pedidos
  Componente modelado agora e previsto
  para implementação na Sprint 3.
end note
@enduml

