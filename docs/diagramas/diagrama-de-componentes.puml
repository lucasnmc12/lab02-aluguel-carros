@startuml diagrama_componentes_aluguel
skinparam shadowing false
skinparam componentStyle rectangle

actor Cliente
node "Computador / navegador" as browser {
  component "Interface HTML" as pagina
}
cloud Internet
node "Servidor central · Spring Boot" as server {
  component "Spring Security\nlogin + sessão + CSRF" as seguranca
  component "Spring MVC\nClienteController\nPedidoController" as controller
  component "Thymeleaf\nconstrução de páginas" as view
  component "ClienteService\nPedidoService" as service
  component "Bean Validation" as validation
  component "Spring Data JPA\nrepositórios" as repository
  database "H2 em memória" as banco
}

Cliente --> pagina
pagina --> Internet : HTTP local / HTTPS em implantação
Internet --> seguranca : requisição
seguranca --> controller : usuário autenticado
controller --> validation : formulários
controller --> service : casos de uso
controller --> view : modelo e view
view --> pagina : HTML
service --> repository : entidades
repository --> banco : JDBC

note bottom of server
  Protótipo da Sprint III: cadastro/login de cliente,
  CRUD do próprio cadastro e criação/consulta de pedidos.
  Avaliação por agente e contratos continuam previstos.
end note
@enduml
